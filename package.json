{
  "name": "kcs-navi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": "11.13.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3000",
    "build": "nuxt build",
    "preview": "npm run preview:workers",
    "preview:workers": "wrangler dev --port 3000",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:d1": "vitest run --project d1",
    "test:nuxt": "vitest run --project nuxt",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "5.3.1",
    "nuxt": "4.6.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.4",
    "@types/node": "24.19.2",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "vue-tsc": "3.3.14",
    "wrangler": "4.156.0"
  }
}
